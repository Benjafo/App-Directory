# Contact form mailer (ZeptoMail)
# Copy to .env on the server and fill in. Never commit .env.

# Send Mail token from ZeptoMail > Mail Agents > (agent) > SMTP/API > API.
# The "Zoho-enczapikey " prefix is optional. Keep the quotes, the value may contain a space.
ZEPTO_TOKEN="Zoho-enczapikey your-token-here"

# API endpoint for your Zoho data center:
# https://api.zeptomail.com (US), https://api.zeptomail.eu (EU), https://api.zeptomail.in (IN)
ZEPTO_API_URL=https://api.zeptomail.com

# Sender. Must be on the domain verified in ZeptoMail. It doesn't need to be a real mailbox.
MAIL_FROM=contact@benjafo.com
MAIL_FROM_NAME="Benjafo Contact Form"

# Where submissions are delivered, comma separated. Replies go to the visitor via Reply-To.
# Specify multiple addresses by comma separation.
MAIL_TO=you@example.com,admin@external.com
